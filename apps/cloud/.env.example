# Agent Review Desk Cloud: environment for the server (apps/cloud).
# UNRELEASED AND BLOCKED: the server refuses every request unless ARD_UNRELEASED_CLOUD=1 is set (development only).
# Copy to a real environment (NOT a committed file), fill in, and see docs/unreleased/cloud-selfhosting.md for each step.
# Every value below is a placeholder.

# --- required -----------------------------------------------------------------
# 32+ random characters (openssl rand -hex 32). Encrypts stored SSO client secrets.
# Changing it later means owners must re-enter their SSO client secret.
ARD_CLOUD_SECRET=
# The public address people use, with https (http only for localhost). Used for sign-in redirects and billing links.
ARD_CLOUD_BASE_URL=https://cloud.example.com

# --- where data lives ---------------------------------------------------------
# One folder: control.db (accounts, billing) + one workspace.db per organization. Needs a persistent disk. Back it up.
ARD_CLOUD_DATA_DIR=/var/lib/agent-review-desk
# Per-organization storage quota in bytes (default 1 GiB).
# ARD_CLOUD_MAX_ORG_BYTES=1073741824
# Set to 1 when ONE reverse proxy sits in front (2 for two hops, ...), so rate limits use the real client address. The address
# is read from the RIGHT end of X-Forwarded-For, where your own proxy appended it; never turn this on without a proxy.
# ARD_CLOUD_TRUST_PROXY=1

# --- sign-in: an OpenID Connect provider (Google, Auth0, Okta, Entra ID...) ---
# Redirect URI to register with it:  <ARD_CLOUD_BASE_URL>/api/auth/callback
ARD_CLOUD_LOGIN_ISSUER=https://accounts.google.com
ARD_CLOUD_LOGIN_CLIENT_ID=
ARD_CLOUD_LOGIN_CLIENT_SECRET=
# ARD_CLOUD_LOGIN_LABEL=Google

# --- payments: configure Paddle, Dodo Payments, or both ------------------------
# Both default to sandbox / test mode. Going live is a deliberate change of *_ENV.
ARD_PADDLE_API_KEY=
ARD_PADDLE_WEBHOOK_SECRET=
ARD_PADDLE_PRICE_ID=
# ARD_PADDLE_ENV=sandbox            # or: production
# Public client-side token for the /pay page (safe to expose; never put an API key here)
ARD_PADDLE_CLIENT_TOKEN=

ARD_DODO_API_KEY=
ARD_DODO_WEBHOOK_SECRET=
ARD_DODO_PRODUCT_ID=
# ARD_DODO_ENV=test_mode            # or: live_mode

# --- local development ONLY (the server refuses these on a non-localhost URL) ---
# ARD_CLOUD_DEV_LOGIN=1             # sign in as anyone by typing an e-mail
# ARD_CLOUD_ALLOW_PRIVATE_OIDC=1    # allow an identity provider on http / a private address
