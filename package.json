{
  "name": "agent-review-desk",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A workspace that records AI agent execution events for human review and approval",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:hooks": "node --test .claude/hooks/block-dangerous.test.mjs",
    "test:e2e": "node scripts/e2e-cloud.mjs",
    "dev:web": "pnpm --filter @ard/web dev",
    "dev:cloud": "pnpm --filter @ard/cloud-web dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
